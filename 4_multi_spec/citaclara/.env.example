# Cadena de conexión a PostgreSQL 16 (requiere la extensión btree_gist disponible).
# Para desarrollo local: docker compose up -d
DATABASE_URL=postgresql://citaclara:citaclara@localhost:5433/citaclara

# Secreto para firmar la cookie de sesión de clínica (FR-018, D5).
# Genera uno propio, p. ej.: openssl rand -hex 32
SESSION_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Clave de panel de la clínica de demostración que la semilla debe hashear (Principio 5).
SEED_CLAVE_CLINICA=eleva2026

# Semilla fija del generador determinista (D6, FR-021).
SEED_SEMILLA=citaclara-eleva-2026

# --- Recordatorios de cita (002) ---
# Datos de remitente/clínica para el .eml (la tabla `clinica` de 001 no los aporta).
CORREO_REMITENTE_NOMBRE=Clínica Eleva
CORREO_REMITENTE_EMAIL=recordatorios@clinicaeleva.es
CLINICA_TELEFONO=+34 900 123 456
# URL base del portal del paciente de 005 (para componer el enlace /p/[token]).
ACCESO_URL_BASE=https://citaclara.example/p
